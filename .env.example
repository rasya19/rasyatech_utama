# ================================================================
# RASYATECH MASTER HUB – Environment Variables
# Copy to .env and fill in your values.
# All VITE_* vars are embedded at build time by Vite.
# ================================================================

# ── Gemini AI (injected automatically by AI Studio / Cloud Run) ──
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ── Master Supabase (Central Registration Gate) ──────────────────
# Required. Used by landing page, admin dashboard, and auth.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key – used by server.ts API endpoints ONLY (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Service role per produk (provisioning tenant + auth admin)
SIPUT_SUPABASE_URL=https://mqvxretzntpkwxspbvap.supabase.co
SIPUT_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY_SIPUT=

LMS_SUPABASE_URL=https://erosuotjshhmhduoprwi.supabase.co
LMS_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY_LMS=

KULINER_SUPABASE_URL=
KULINER_SERVICE_ROLE_KEY=

# ── Product Pillar Supabase Projects (optional) ───────────────────
# If omitted, each product falls back to the master project.
# Set these to point to separate Supabase projects for data isolation.

# Armilla LMS
VITE_SUPABASE_URL_LMS=
VITE_SUPABASE_ANON_KEY_LMS=

# SIPUT (PAUD/TK E-Rapor)
VITE_SUPABASE_URL_SIPUT=
VITE_SUPABASE_ANON_KEY_SIPUT=

# Scanbite (Smart Restaurant)
VITE_SUPABASE_URL_SCANBITE=
VITE_SUPABASE_ANON_KEY_SCANBITE=

# Instafood (Catering Pre-Order) – previously VITE_SUPABASE_URL_KULINER
VITE_SUPABASE_URL_INSTAFOOD=
VITE_SUPABASE_ANON_KEY_INSTAFOOD=

# Resto (Hybrid POS)
VITE_SUPABASE_URL_RESTO=
VITE_SUPABASE_ANON_KEY_RESTO=

# ── Email (server.ts nodemailer) ──────────────────────────────────
EMAIL_USER=
EMAIL_PASS=
